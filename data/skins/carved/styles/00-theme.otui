// The carved palette. Shadows data/styles/00-theme.otui while the skin is mounted (SKIN
// in init.lua); same fifteen roles, same rule -- chrome only, a colour with meaning never
// lives here. The fills follow the tone ladder in tools/skin-generators/make_carved.ps1
// ($Look.Tone) so a Lua-painted panel matches a generated one; text is parchment; the one
// accent is the aged gold of the title lines, used for selection and hover.

&textColor: #d8ccb2
&textBright: #f2e8d2
&textDim: #968a72
&textDisabled: #d8ccb255
&textMuted: #6c6150

&panelFill: #1d1914
&panelFillDark: #14110d
&panelFillDeep: #0c0a08
&panelFillRaised: #27221b
&panelFillLight: #342c22

&borderColor: #4f4435
&borderLight: #745a30
&separatorColor: #0b0a07

&selectionFill: #5c4620
&selectionText: #fff3d8
&hoverOverlay: #c99a4e22
&headerBevelLight: #66666640
&headerBevelShadow: #31313160
&headerBorderColor: #0b0a07
