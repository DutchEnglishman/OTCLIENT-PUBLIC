game
  sprite-size: 32
  draw-typing: false
  typing-icon: /images/game/console/typing
  
  map
    // Pre-login only. On login the server sends its own range via
    // sendChangeMapAwareRange (OTSERV protocolgame.cpp:1844, 31x18), and
    // parseChangeMapAwareRange overwrites whatever is set here -- so changing
    // this value has no effect on the in-game view.
    viewport: 12 9
    extended-view-ui: true
    max-z: 15
    sea-floor: 7
    underground-floor: 8
    aware-underground-floor-range: 2

  tile
    max-elevation: 24
    // Must be the same number as OTSERV's TILE_MAX_THINGS (src/const.h): the
    // server numbers a tile's things up to it and Tile::addThing drops
    // everything past it here, so a mismatch leaves every stack position above
    // the lower of the two pointing at a different thing on the two sides.
    max-things: 40
    transparent-floor-view-range: 2

  creature
    draw-information-by-widget-beta: false
    force-new-walking-formula: false
    shield-blink-ticks: 500
    volatile-square-duration: 1000
    adjust-creature-information-based-crop-size: false
    use-crop-size-for-ui-draw: true
    diagonal-walk-speed: 3
    // How fast the walking sprite cycles its frames. 1 is the stock timing,
    // lower is slower; read at startup, so tuning it needs a client restart
    // but no rebuild. Purely cosmetic -- how long a step takes still comes
    // from the server's speed value (Creature::getStepDuration), so this
    // cannot desync anything.
    walk-animation-speed: 0.7

  player
    // What a diagonal step costs the PLAYER, in plain step durations. This is
    // not taste: it has to be the server's own figure or every diagonal is dead
    // time. TFS charges a player two (Creature::onCreatureMove takes the shared
    // diagonal cost of 3 back down by one for a player) and lets him step again
    // at that point, so a 3 here made the client sit out a whole extra step
    // duration on every diagonal that the server was already done waiting for.
    // Monsters keep 3 under `creature` above, which is what TFS charges them.
    diagonal-walk-speed: 2

  render
    // Milliseconds one animation frame is held. Bigger is slower. Engine
    // defaults (gameconfig.h:133) are 500 / 500 / 75 / 75; invisible sits
    // past its default on purpose, because stock reads as frantic here.
    //
    // invisible = creature invisibility sparkles
    // item      = torches, fire and energy fields, every animated map item,
    //             and creature sprite animation (creature.cpp:489)
    // effect    = magic effects, missile = projectiles in flight
    invisible-ticks-per-frame: 750
    item-ticks-per-frame: 500
    effect-ticks-per-frame: 75
    missile-ticks-per-frame: 75
    animated-text-duration: 1000
    static-duration-per-character: 60
    min-static-text-duration: 3000

font
  widget: verdana-11px-antialised
  static-text: verdana-11px-rounded
  animated-text: verdana-11px-rounded
  creature-text: verdana-11px-rounded
  item-count: verdana-10px-rounded
