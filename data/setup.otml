game
  sprite-size: 32
  draw-typing: false
  typing-icon: /images/game/console/typing
  
  map
    // Pre-login only. On login the server sends its own range via
    // sendChangeMapAwareRange (OTSERV protocolgame.cpp:1844, 31x18), and
    // parseChangeMapAwareRange overwrites whatever is set here -- so changing
    // this value has no effect on the in-game view.
    viewport: 12 9
    extended-view-ui: true
    max-z: 15
    sea-floor: 7
    underground-floor: 8
    // floors sent above/below the player underground; must match the server's
    // Map::undergroundFloorsUp/Down (src/map.h) or the map packet mis-parses
    aware-underground-floor-range-up: 2
    aware-underground-floor-range-down: 3
    // Map pixels per sprite pixel. A walking creature and the camera are placed
    // on this grid, so at 1 the screen scrolls in whole sprite pixels, which at
    // the usual ~2x window stretch reads as jitter (2,4,2,4 screen px a frame);
    // at 2 it moves on roughly screen pixels. 2 is also the look picked between
    // the old soft blur (1) and hard-edged pixels (3, which a ~2.3x window
    // shrinks onto uneven blocks). 1-4. Read at startup: a client restart, no
    // rebuild.
    render-scale: 2
    // How much of the old soft look is laid back over the 2x map, 0-1: 0 is
    // hard pixels, 1 the old blur. 0.6 was picked against another client's
    // screenshot. Only with render-scale 2 and antialiasing enabled; names and
    // health bars are drawn separately and stay sharp. Client restart, no
    // rebuild.
    smoothing: 0.6
    // true: the map is rebuilt the moment the screen takes the last build, so
    // every frame shows the walk exactly one frame old. false: the map thread
    // runs on its own timer (twice the refresh rate, at least 120/s), which
    // drifts against the screen's rate and made each frame's position 1-9 ms
    // old at random -- measured as the walking jitter. Client restart, no
    // rebuild.
    frame-sync: true

  tile
    max-elevation: 24
    // Must be the same number as OTSERV's TILE_MAX_THINGS (src/const.h): the
    // server numbers a tile's things up to it and Tile::addThing drops
    // everything past it here, so a mismatch leaves every stack position above
    // the lower of the two pointing at a different thing on the two sides.
    max-things: 40
    transparent-floor-view-range: 2

  creature
    draw-information-by-widget-beta: false
    force-new-walking-formula: false
    shield-blink-ticks: 500
    volatile-square-duration: 1000
    adjust-creature-information-based-crop-size: false
    use-crop-size-for-ui-draw: true
    diagonal-walk-speed: 3
    // How fast the walking sprite cycles its frames. 1 is the stock timing,
    // lower is slower; read at startup, so tuning it needs a client restart
    // but no rebuild. Purely cosmetic -- how long a step takes still comes
    // from the server's speed value (Creature::getStepDuration), so this
    // cannot desync anything.
    walk-animation-speed: 0.7

  player
    // What a diagonal step costs the PLAYER, in plain step durations. This is
    // not taste: it has to be the server's own figure (OTSERV
    // Creature::onCreatureMove, 3 for everyone as in TFS 0.4 r3777), or the
    // client is either ahead of the server and bounced, or sits out dead time.
    diagonal-walk-speed: 3

  render
    // Milliseconds one animation frame is held. Bigger is slower. Engine
    // defaults (gameconfig.h:135) are 500 / 500 / 75 / 75; invisible sits
    // past its default on purpose, because stock reads as frantic here. Item
    // stays at 500: every 2-frame item CipSoft kept unchanged into 10.98 is
    // 500 ms there, so that is the classic figure. Effect started at 100, the
    // figure 10.98 uses for the 8.60 effects whose frame count CipSoft kept
    // (at 75 ours ran a median 1.47x short of theirs), and is 90 by choice:
    // spell effects 10% quicker than that. Missiles have no timing in any dat (a missile flies
    // 2 x this x sqrt(tiles) ms, missile.cpp:87), so they keep the stock 75; a
    // slower one only lands further behind the damage the server sent with it.
    //
    // invisible = creature invisibility sparkles
    // item      = torches, fire and energy fields, every animated map item,
    //             and a creature dressed as an item (creature.cpp:534)
    // effect    = magic effects, missile = projectiles in flight
    invisible-ticks-per-frame: 750
    item-ticks-per-frame: 500
    effect-ticks-per-frame: 90
    missile-ticks-per-frame: 75
    animated-text-duration: 1000
    static-duration-per-character: 60
    min-static-text-duration: 3000

font
  widget: verdana-11px-antialised
  static-text: verdana-11px-rounded
  animated-text: verdana-11px-rounded
  creature-text: verdana-11px-rounded
  item-count: verdana-10px-rounded
