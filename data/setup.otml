game
  sprite-size: 32
  draw-typing: false
  typing-icon: /images/game/console/typing
  
  map
    // Pre-login only. On login the server sends its own range via
    // sendChangeMapAwareRange (OTSERV protocolgame.cpp:1844, 31x18), and
    // parseChangeMapAwareRange overwrites whatever is set here -- so changing
    // this value has no effect on the in-game view.
    viewport: 12 9
    extended-view-ui: true
    max-z: 15
    sea-floor: 7
    underground-floor: 8
    aware-underground-floor-range: 2

  tile
    max-elevation: 24
    max-things: 10
    transparent-floor-view-range: 2

  creature
    draw-information-by-widget-beta: false
    force-new-walking-formula: false
    shield-blink-ticks: 500
    volatile-square-duration: 1000
    adjust-creature-information-based-crop-size: false
    use-crop-size-for-ui-draw: true
    diagonal-walk-speed: 3
    // How fast the walking sprite cycles its frames. 1 is the stock timing,
    // lower is slower; read at startup, so tuning it needs a client restart
    // but no rebuild. Purely cosmetic -- how long a step takes still comes
    // from the server's speed value (Creature::getStepDuration), so this
    // cannot desync anything.
    walk-animation-speed: 0.7

  player
    diagonal-walk-speed: 3

  render
    invisible-ticks-per-frame: 75
    item-ticks-per-frame: 468
    effect-ticks-per-frame: 75
    missile-ticks-per-frame: 75
    animated-text-duration: 1000
    static-duration-per-character: 60
    min-static-text-duration: 3000

font
  widget: verdana-11px-antialised
  static-text: verdana-11px-rounded
  animated-text: verdana-11px-rounded
  creature-text: verdana-11px-rounded
  item-count: verdana-10px-rounded
