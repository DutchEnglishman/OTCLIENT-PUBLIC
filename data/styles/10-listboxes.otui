TextList < UIScrollArea
  layout: verticalBox
  border-width: 1
  border-color: $separatorColor
  background-color: $panelFillDeep
  padding: 1
  auto-focus: none

HorizontalList < UIScrollArea
  layout: horizontalBox
  border-width: 1
  border-color: $separatorColor
  background-color: $panelFillDeep

VerticalList < UIScrollArea
  layout: verticalBox
  border-width: 1
  border-color: $separatorColor
  background-color: $panelFillDeep