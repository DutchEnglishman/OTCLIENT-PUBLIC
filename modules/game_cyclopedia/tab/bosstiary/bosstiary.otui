UIWidget
  id: Cat7
  anchors.fill: parent
  visible: false
  margin-bottom:30
  UIWidget
    id: FilterBase
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 10
    // Was window_new at border 10, which put that image's band and its accent line inside
    // the tiled middle and repeated them down the panel. Panel surface, real band, sliced
    // at what it was built for.
    image-source: /images/ui/panel_window_header
    image-border: 4
    image-border-top: 20
    height: 50
    !text: tr('Filter')
    text-align: top
    text-offset: 0 6
    color: #919191
    CheckBox
      id: NoKillsCheck
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 27
      margin-left: 10
      !text: tr('No Kills')
      text-auto-resize: true
      checked: true
      @onClick: modules.game_cyclopedia.Cyclopedia.changeBosstiaryFilter(self, self:isChecked())
    CheckBox
      id: KilledCheck
      anchors.top: NoKillsCheck.top
      anchors.left: NoKillsCheck.right
      margin-left: 30
      !text: tr('Killed')
      text-auto-resize: true
      checked: true
      @onClick: modules.game_cyclopedia.Cyclopedia.changeBosstiaryFilter(self, self:isChecked())
  UIWidget
    id: ListBase
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: FilterBase.bottom
    anchors.bottom: parent.bottom
    margin-bottom: 30
    margin-top: 10
    image-source: /images/ui/panel_flat
    image-border: 10
    UIScrollArea
      id: BossList
      anchors.fill: parent
      padding-left: 4
      padding-top: 4
      margin-left: 3
      layout:
        type: grid
        cell-size: 159 151
        cell-spacing: 5
        flow: true
  // The two bosstiary sections; the one on screen is "on" (bright text).
  Button
    id: MainlandButton
    size: 60 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 5
    !text: tr('Mainland')
    font: small-9px
    text-offset: 0 -1
    color: #808080
    @onClick: modules.game_cyclopedia.Cyclopedia.showBosstiarySection("mainland")
    $on:
      color: #FFFFFF
  Button
    id: RookgaardButton
    size: 60 20
    anchors.left: MainlandButton.right
    anchors.bottom: MainlandButton.bottom
    margin-left: 4
    !text: tr('Rookgaard')
    font: small-9px
    text-offset: 0 -1
    color: #808080
    @onClick: modules.game_cyclopedia.Cyclopedia.showBosstiarySection("rookgaard")
    $on:
      color: #FFFFFF
  TextEdit
    id: SearchEdit
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    padding-top: 2
    padding-right: 15
    margin-bottom: 5
    size: 150 20
    placeholder: Type to search
    placeholder-color: #6E706F
    @onTextChange: modules.game_cyclopedia.Cyclopedia.BosstiarySearchText(self:getText())
  UIWidget
    id: SearchClearButton
    anchors.right: SearchEdit.right
    anchors.top: SearchEdit.top
    margin-top: 1
    margin-right: 1
    image-source: /images/ui/button-clear-18x18-up
    @onClick: modules.game_cyclopedia.Cyclopedia.BosstiarySearchText("", true)
    $pressed:
      image-source: /images/ui/button-clear-18x18-down
  UIWidget
    id: PageValue
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 5
    size: 60 20
    text-align: center
    !text: tr('1 / 1')
    color: #C2C2C2
  Button
    id: NextPageButton
    anchors.left: PageValue.right
    anchors.bottom: PageValue.bottom
    size: 20 20
    icon-source: /game_cyclopedia/images/icon-right-arrow
    @onClick: modules.game_cyclopedia.Cyclopedia.changeBosstiaryPage(false, true)
    $pressed:
      icon-source: /game_cyclopedia/images/icon-right-arrow
    $disabled:
      icon-source: /game_cyclopedia/images/icon-right-arrow-disabled
  Button
    id: PrevPageButton
    anchors.right: PageValue.left
    anchors.bottom: PageValue.bottom
    size: 20 20
    icon-source: /game_cyclopedia/images/icon-left-arrow
    @onClick: modules.game_cyclopedia.Cyclopedia.changeBosstiaryPage(true, false)
    $pressed:
      icon-source: /game_cyclopedia/images/icon-left-arrow-disabled
    $disabled:
      icon-source: /game_cyclopedia/images/icon-left-arrow-disabled
