
SpecialConditionLabelSettings < UIWidget
  height: 20

  UIWidget
    id: icon
    size: 10 10
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5

  Label
    id: label
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    color: $textBright

  // showInHudCheckBox is gone: special conditions are bar-only now, so the row
  // has one column. See statusiconbar.lua's defaultSettings for the flag that
  // keeps them out of the HUD.
  CheckBox
    id: showInBarCheckBox
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    // 142, not 50: this takes over the slot showInHudCheckBox occupied, which
    // was showInBarCheckBox.left - 80, i.e. parent.right - 50 - 12 - 80. The
    // Show in Bar header in HUD.otui moved into the same slot.
    margin-right: 142
    image-source: /images/ui/checkbox
    image-clip: 0 0 12 12

OptionsCategory < UIWidget
  size: 115 22
  image-source: /images/ui/1pixel_down_frame
  image-border: 5
  UIWidget
    id: Button
    size: 115 20
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 1
    margin-top: 1
    image-source: /images/ui/button-grey-up
    image-border: 5
    opacity: 1.0
    $pressed:
      image-source: /images/ui/button-grey-down
    $checked:
      image-source: /images/ui/button-grey-down
    UIWidget
      id: Icon
      size: 13 13
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      phantom: true
      $checked:
        margin-left: 11
        margin-top: 1
      $!checked:
        margin-left: 10
        margin-top: 0
    Label
      id: Title
      anchors.left: Icon.right
      anchors.verticalCenter: Icon.verticalCenter
      margin-left: 10
      text-align: center
      text-auto-resize: true
      !text: tr('General Stats')
      color: #ffffff
      font: cipsoftFont
      $checked:
        text-offset: 12 10
      $!checked:
        text-offset: 0 0
    UIWidget
      id: Arrow
      size: 7 7
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 5
      phantom: true
      image-source: /images/ui/icon-arrow7x7-down
      visible: false

OptionCheckBox < QtCheckBox
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  color: $textColor
  @onCheckChange: modules.client_options.setOption(self:getId(), self:isChecked())

OptionCheckBoxMarked < OptionCheckBox
  UIWidget
    id: toolTipWidget
    image-source: /images/icons/show_gui_help_grey
    size: 12 12  
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

OptionScaleScroll < Label
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  text-align: left
  text-offset: 18 0
  color: $textColor

  HorizontalQtScrollBar
    id: valueBar
    step: 1
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    width: 174
    @onValueChange: |
      modules.client_options.setOption(self:getParent():getId(), self:getValue())

OptionLabelMarked < Label
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  text-align: left
  text-offset: 18 0
  color: $textColor

  UIWidget
    id: toolTipWidget
    image-source: /images/icons/show_gui_help_grey
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

OptionScaleScrollMarked < Label
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  text-align: left
  text-offset: 18 0
  color: $textColor

  UIWidget
    id: toolTipWidget
    image-source: /images/icons/show_gui_help_grey
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

  HorizontalQtScrollBar
    id: valueBar
    step: 1
    anchors.right: toolTipWidget.left
    anchors.verticalCenter: toolTipWidget.verticalCenter
    margin-right: 10
    width: 174
    @onValueChange: |
      modules.client_options.setOption(self:getParent():getId(), self:getValue())

// This window used to opt out of the carved frame by naming its own image, which is why it
// was the one pop-up still wearing the flat edge while the autoloot, bestiary, hotkey and
// cyclopedia windows had the moulding. The override is gone, so it inherits Window's frame
// like everything else (10-windows.otui) -- and with it the 12px moulding and the 27-row
// title band, against the 4 and 16 it drew before.
//
// Nothing here is anchored to the content box: the caption, the tab bar and the Ok button
// all hang off parent.top or parent.bottom by a NEGATIVE margin, deliberately reaching out
// past the padding into the chrome. That is exactly the space the moulding now occupies,
// so each of the three moves in by what it was borrowing -- the tab bar 10 at the top, the
// button 8 at the bottom -- and the window is 18 taller to give both back. The tab bar
// spans 462px either way; measure it if you change any of the four margins below.
MainWindow
  id: optionsWindow
  size: 686 552
  anchors.centerIn: parent
  visible: false
  draggable: true
  icon-rect: 4 4 16 16
  @onEnter: modules.client_options.hide()
  @onEscape: modules.client_options.hide()
  $mobile:
    size: 500 398

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 2
    margin-bottom: 23

  // 23 above the content box puts the caption on y 18, which is where Window's own
  // text-offset puts every other pop-up's.
  Label
    !text: tr('Settings')
    font: verdana-11px-antialised
    margin-top: -23
    text-align: top
    anchors.top: parent.top

    anchors.left: parent.left
    anchors.right: parent.right
    opacity: 0.5

  UIWidget
    id: optionsTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: separator.bottom
    margin-left: 1
    margin-top: 0
    margin-bottom: 10
    image-border: 3
    image-source: /images/ui/2pixel_up_frame_borderimage_dark
    size: 128 423

  QtPanel
    id: optionsTabContent
    anchors.top: optionsTabBar.top
    anchors.left: optionsTabBar.right
    anchors.right: parent.right
    anchors.bottom: separator.bottom
    margin-left: 10
    margin-bottom: 10

  QtButton
    !text: tr('Ok')
    size: 64 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 0
    @onClick: |
      modules.client_options.saveOptions()
      modules.client_options.hide()
