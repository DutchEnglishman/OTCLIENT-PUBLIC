PhantomMiniWindow
  id: mainmappanel
  draggable: true
  phantom: false
  moveOnlyToMain: false
  &panelHeight: 116
  height: 116

  UIWidget
    id: minimapBorder
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 8
    // Was 55, to clear a column of controls down the right-hand side: the
    // layer strip, the compass rose and the fullscreen button. All three are
    // gone, so the map takes the full width and the four remaining buttons
    // float over its bottom-right corner instead of sitting beside it.
    margin-right: 8
    height: 111
    // image-source removed: 1pixel_down_frame drew the inset dark frame around
    // the map. The widget is kept as the position reference the buttons anchor
    // to. margin drops to 0 so the map fills the space the frame used.

    Minimap
      id: minimap
      anchors.fill: parent
      margin: 0

  // Floor on the left, zoom on the right, stacked into a 2x2 block inset into
  // the map's bottom-right corner. Everything chains off zoomOut, the corner
  // button, so moving that one moves the block. It is declared first for that
  // reason -- the other three anchor to it.
  //
  // The zoom pair keep the automap artwork (a 40x60 sheet: three 20x20 rows,
  // normal in the left column, pressed in the right). That sheet has no arrows,
  // so the floor pair use the spinbox arrows: 10x10 cells, normal/hover/pressed
  // stacked vertically.
  //
  // UIButton, NOT Button: the Button style carries image-border: 1
  // (10-buttons.otui:8), and a bordered image is drawn REPEATED --
  // uiwidgetimage.cpp:125, useRepeated = hasProp(PropImageBordered). Scaling a
  // 10x10 source into 20x20 therefore tiled the 8x8 middle across an 18x18
  // interior and drew two and a bit arrows.
  //
  // Simply omitting image-border does not help, because the style's value is
  // inherited; nor does image-border: 0, because setImageBorder() sets the
  // bordered flag unconditionally whatever the width. Deriving from the raw
  // class is what actually leaves the flag unset, so the clip is scaled to the
  // widget: one arrow, an exact 2x, kept crisp by image-smooth: false.
  //
  // The zoom buttons keep the Button style safely -- their clip is 20x20 drawn
  // into a 20x20 widget, so the repeat count is exactly one and nothing tiles.
  //
  // image-size/image-offset rather than letting the 10x10 clip stretch to fill
  // the widget: they set m_imageRect, which drawImage uses as the destination,
  // so the chevron is blitted 1:1 at its native size and centred in the 20x20
  // click target. No scaling anywhere in the path, so nothing can repeat.
  Button
    id: zoomOut
    !tooltip: tr('Zoom out')
    image-source: /images/automap/automap_buttons
    image-clip: 0 20 20 20
    anchors.right: minimapBorder.right
    anchors.bottom: minimapBorder.bottom
    margin-right: 4
    margin-bottom: 4
    size: 20 20
    @onClick: zoomOut()

    $pressed !disabled:
      image-clip: 20 20 20 20

  UIButton
    id: floorDown
    !tooltip: tr('Go down one floor')
    image-source: /images/ui/spinbox_down
    image-clip: 0 0 10 10
    image-size: 10 10
    image-offset: 5 5
    image-smooth: false
    anchors.right: zoomOut.left
    anchors.bottom: zoomOut.bottom
    margin-right: 2
    size: 20 20
    @onClick: downLayer()

    $hover !disabled:
      image-clip: 0 10 10 10

    $pressed !disabled:
      image-clip: 0 20 10 10

  UIButton
    id: floorUp
    !tooltip: tr('Go up one floor')
    image-source: /images/ui/spinbox_up
    image-clip: 0 0 10 10
    image-size: 10 10
    image-offset: 5 5
    image-smooth: false
    anchors.right: floorDown.right
    anchors.bottom: floorDown.top
    margin-bottom: 2
    size: 20 20
    @onClick: upLayer()

    $hover !disabled:
      image-clip: 0 10 10 10

    $pressed !disabled:
      image-clip: 0 20 10 10

  Button
    id: zoomIn
    !tooltip: tr('Zoom in')
    image-source: /images/automap/automap_buttons
    image-clip: 0 40 20 20
    anchors.right: zoomOut.right
    anchors.bottom: zoomOut.top
    margin-bottom: 2
    size: 20 20
    @onClick: zoomIn()

    $pressed !disabled:
      image-clip: 20 40 20 20


// Controls for the fullscreen map (Ctrl+Shift+M). The docked panel that
// normally carries these is hidden while fullscreen, so this is a separate
// overlay created by fullscreen() and destroyed when it closes. Same artwork
// and the same handlers as the docked copies, so both stay in step.
MinimapFullscreenControls < UIWidget
  id: minimapFullscreenControls
  size: 46 68
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  margin-right: 12
  margin-bottom: 12
  phantom: false

  UIWidget
    id: layersPanel
    size: 20 68
    anchors.bottom: parent.bottom
    anchors.right: parent.right

    UIWidget
      id: automapLayers
      image-source: /images/automap/automap_indicator_maplayers
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      image-clip: 98 0 14 67
      size: 14 67

    UIWidget
      id: layersMark
      anchors.left: automapLayers.right
      anchors.top: automapLayers.top
      image-source: /images/automap/automap_indicator_slider_left
      margin-left: 3
      margin-top: 28

    // Phantom artwork over the top and bottom halves of the layer strip, the
    // same split the docked panel uses: upper half climbs, lower half descends.
    //
    // No @onClick anywhere in this style, unlike the docked panel above. An
    // @onClick in an IMPORTED style resolves its names in the global
    // environment, not this module's, so upLayer/downLayer/zoomIn/zoomOut all
    // came back nil. The docked copies work only because loadUI compiles their
    // expressions inside the module that loaded the file. fullscreen() assigns
    // these handlers from Lua instead, which is why they carry ids.
    Button
      id: layerUp
      image-source: /images/automap/automap_phantom
      anchors.left: automapLayers.left
      anchors.right: automapLayers.right
      anchors.top: automapLayers.top
      anchors.bottom: automapLayers.verticalCenter

    Button
      id: layerDown
      image-source: /images/automap/automap_phantom
      anchors.left: automapLayers.left
      anchors.right: automapLayers.right
      anchors.top: automapLayers.verticalCenter
      anchors.bottom: automapLayers.bottom

  Button
    id: zoomIn
    image-source: /images/automap/automap_buttons
    image-clip: 0 40 20 20
    anchors.right: layersPanel.left
    anchors.bottom: layersPanel.bottom
    margin-right: 4
    size: 20 20

    $pressed !disabled:
      image-clip: 20 40 20 20

  Button
    id: zoomOut
    image-source: /images/automap/automap_buttons
    image-clip: 0 20 20 20
    anchors.right: zoomIn.right
    anchors.bottom: zoomIn.top
    margin-bottom: 2
    size: 20 20

    $pressed !disabled:
      image-clip: 20 20 20 20
