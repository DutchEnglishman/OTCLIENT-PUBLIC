TextMessageLabel < UILabel
  font: verdana-11px-rounded
  text-align: center
  text-wrap: true
  text-auto-resize: true
  margin-bottom: 2
  visible: false

// Every on-screen message but private ones: created on the map widget by
// textmessage.lua and stacked under the character's feet by placeMapLabels, so
// resizing the chat never moves them. Phantom so a click on the map under one
// still reaches the map.
ScreenMessageLabel < TextMessageLabel
  width: 303
  phantom: true

PrivateMessageLabel < TextMessageLabel
  id: privateLabel
  width: 290
  phantom: true

// Status lines stay just above the chat, so this panel's bottom tracks the chat
// panel itself, NOT gameMapPanel and NOT bottomSplitter.
//
// gameMapPanel is wrong because extended view mode calls gameMapPanel:fill(
// 'parent') (gameinterface.lua:1974) -- the map then covers the whole screen
// and the chat is drawn over it, so a message placed near the map's bottom
// lands underneath the chat.
//
// bottomSplitter is wrong for the same mode: applyExtendedViewLayout calls
// gameBottomPanel:breakAnchors() and makes the chat a free, draggable panel
// with its own bottomResizeBorder, so the splitter stops driving its height.
//
// gameBottomPanel.top is correct in both modes -- in windowed mode it still
// follows the splitter, and in extended mode it follows the panel wherever it
// is dragged or resized to. It is a sibling under gameRootPanel, so the id
// resolves (anchors look the target up among the parent's children only).
Panel
  anchors.left: gameMapPanel.left
  anchors.right: gameMapPanel.right
  anchors.top: gameMapPanel.top
  anchors.bottom: gameBottomPanel.top
  focusable: false

  TextMessageLabel
    id: statusLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    // Clearance above the chat's resize handle, since that is now this
    // panel's bottom edge.
    margin-bottom: 10
    width: 300
