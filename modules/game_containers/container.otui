PageButton < UIButton
  size: 18 18


ContainerWindow < MiniWindow
  height: 150
  &save: true
  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    color: #9d9d9dff

  UIItem
    id: containerItemWidget
    virtual: true
    size: 15 15
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4

  UIButton
    id: upButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 3
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 42 0 14 14

    $hover:
      image-clip: 42 14 14 14

    $pressed:
      image-clip: 42 28 14 14

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.bottom: next.top
    margin-left: 3
    margin-bottom: 1
    margin-top: -2
    margin-right: 1
    // The right anchor is NOT set here. This node derives from
    // MiniWindowContents, which anchors right to miniwindowScrollBar.left, and
    // restating anchors.right in a derived node does not replace that -- it was
    // tried and measured as having no effect, leaving the scrollbar's 15px
    // reserved and dropping the grid to 4 columns once the window narrowed.
    // containers.lua re-anchors it from Lua instead, where addAnchor really
    // does replace the existing anchor for that edge.
    // Tightened from 6 padding / 3 spacing. Both feed the column maths in
    // UIGridLayout::internalUpdate (uigridlayout.cpp:74):
    //     columns = (paddingRect.width + cellSpacing) / (cellSize + cellSpacing)
    // and paddingRect.width is this panel's width minus the padding below, so
    // shrinking either lets five 34px slots fit in a narrower window.
    //
    // A row of five is 5*34 + 4*1 = 174 wide. GameSidePanel is 184, which makes
    // paddingRect.width 176 -- two more than the row needs. The grid packs from
    // the left, so those two pixels land on the right, and together with this
    // padding and the 1px margin they make both sides 5px. Keep the two in
    // step: changing the spacing or padding here without moving that width
    // either drops the fifth column or reopens the gap.
    padding-left: 2
    padding-top: 2
    padding-right: 2
    padding-bottom: 2
    layout:
      type: grid
      cell-size: 34 34
      cell-spacing: 1
      // Five per row, stated outright. With flow on, UIGridLayout derives the
      // column count from the available width every relayout
      // (uigridlayout.cpp:75), so a pixel lost anywhere in the chain -- window
      // margins, panel padding, a zero-width scrollbar still holding its own
      // margin -- silently drops the grid to four. It did, repeatedly. Off, the
      // count is simply what it says here and the width only has to be wide
      // enough not to clip the fifth slot.
      //
      // A row needs 5*34 + 4*1 = 174 of clip; GameSidePanel's 184 gives 176.
      // containers.lua derives its row count from getNumColumns rather than
      // getNumLines, which the flow branch is the only thing that maintains.
      flow: false
      num-columns: 5
  
  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-left: 3
    margin-right: 3
    margin-bottom: 3

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 20
    margin: 2 2 4 3
    visible: false

    Label
      id: pageLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      margin-left: -8
      text-auto-resize: true

    PageButton
      id: prevPageButton
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 5
      image-source: /images/ui/container-browse-left-up

      $pressed:
        image-source: /images/ui/container-browse-left-down

      $pressed disabled:
        image-source: /images/ui/container-browse-left-up

    PageButton
      id: nextPageButton
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 5
      image-source: /images/ui/container-browse-right-up

      $pressed:
        image-source: /images/ui/container-browse-right-down

      $pressed disabled:
        image-source: /images/ui/container-browse-right-up


  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder
    size: 14 14
    margin-left: 4
    margin-bottom: 4

ContainersSubMenuOption < ThickCheckBox
  text-offset: 18 1
  text-align: left
  color: white
  background-color: alpha
  font: verdana-11px-rounded
  padding: 3 6

  $hover:
    background-color: #ffffff1a

  $disabled:
    color: #c0c0c0ff

ContainersListOption < UIButton
  text-align: left
  color: white
  background-color: alpha
  font: verdana-11px-rounded
  padding: 3 6
  margin-left: 5

  $hover:
    background-color: #ffffff1a

  $disabled:
    color: #c0c0c0ff

ContainersSubMenu < PopupMenu
  id: containersSubMenu
  width: 285

  ContainersListOption
    id: sortAscByName
    !text: tr('Sort Ascending by Name')
  ContainersListOption
    id: sortDescByName
    !text: tr('Sort Descending by Name')
  ContainersListOption
    id: sortAscByWeight
    !text: tr('Sort Ascending by Weight')
  ContainersListOption
    id: sortDescByWeight
    !text: tr('Sort Descending by Weight')
  ContainersListOption
    id: sortAscByExpiry
    !text: tr('Sort Ascending by Expiry')
  ContainersListOption
    id: sortDescByExpiry
    !text: tr('Sort Descending by Expiry')
  ContainersListOption
    id: sortAscByStackSize
    !text: tr('Sort Ascending by Stack Size')
  ContainersListOption
    id: sortDescByStackSize
    !text: tr('Sort Descending by Stack Size')

  HorizontalSeparator
    margin-top: 2
    margin-bottom: 3

  ContainersSubMenuOption
    id: sortContainersFirst
    !text: tr('Sort Containers First')

  ContainersSubMenuOption
    id: sortNestedContainers
    !text: tr('Sort Nested Containers')

  ContainersSubMenuOption
    id: useManualSortMode
    !text: tr('Use Manual Sort Mode')

  HorizontalSeparator
    margin-top: 2
    margin-bottom: 3

  ContainersListOption
    id: moveToObtainContainers
    !text: tr('Move Contents to \'Obtain\' Containers')

  ContainersSubMenuOption
    id: moveNestedContainers
    !text: tr('Move Nested Containers')
  