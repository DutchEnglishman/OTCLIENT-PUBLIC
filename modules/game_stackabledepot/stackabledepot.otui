// One cell of the depot grid: the item's sprite with its amount underneath.
// The amount is a label rather than the UIItem's own count, because a tile
// holds up to 1000 and the sprite's built-in count is a stack count.
DepotTile < Panel
  // Panel is phantom by default (data/styles/10-panels.otui), which means it
  // never sees a mouse click. ItemListItem in game_crafting does the same.
  phantom: false
  size: 46 46
  image-source: /images/ui/button
  image-color: #ababab
  image-clip: 0 0 22 23
  image-border: 3

  $hover:
    image-color: #dfdfdf

  $on:
    image-color: #ffffff

  UIItem
    id: sprite
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    size: 32 32
    virtual: true
    phantom: true

  Label
    id: amount
    // A Label is NOT phantom by default, and this one spans the tile, so
    // without this it swallows every click over the amount text.
    phantom: true
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 1
    text-align: center
    font: verdana-11px-antialised
    color: $textBright

// Modelled on the client's own CountWindow so taking items out looks like
// splitting a stack anywhere else. Its own copy because the game_interface one
// is driven by a local helper that needs a real Thing, and a tile is not one.
// The filter row under the grid. Built from whatever categories the server
// sends, so a new filter is a server-side edit only.
FilterButton < UIButton
  font: verdana-11px-antialised
  color: $textBright
  height: 22
  image-source: /images/ui/button
  image-color: #ababab
  image-clip: 0 0 22 23
  image-border: 3
  padding-left: 8
  padding-right: 8

  $hover !disabled:
    image-color: #dfdfdf

  $on:
    image-color: #ffffff

DepotAmountWindow < MainWindow
  id: depotAmountWindow
  size: 196 104

  UIItem
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 2
    size: 32 32
    virtual: true
    focusable: false

  HorizontalScrollBar
    id: countScrollBar
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.top: prev.top
    margin-left: 10
    margin-top: -2
    focusable: false

  Label
    id: amountLabel
    phantom: true
    anchors.left: countScrollBar.left
    anchors.right: countScrollBar.right
    anchors.top: countScrollBar.bottom
    margin-top: 2
    text-align: center
    color: $textBright

  Button
    id: buttonCancel
    !text: tr('Cancel')
    height: 20
    anchors.left: countScrollBar.horizontalCenter
    anchors.right: countScrollBar.right
    anchors.top: amountLabel.bottom
    margin-top: 4
    focusable: false

  Button
    id: buttonOk
    !text: tr('Ok')
    height: 20
    anchors.right: countScrollBar.horizontalCenter
    anchors.left: countScrollBar.left
    anchors.top: amountLabel.bottom
    margin-top: 4
    margin-right: 6
    focusable: false

MainWindow
  id: stackableDepotWindow
  text: Stackable Stash
  size: 780 537

  Label
    id: usage
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    text-auto-resize: true
    color: $textBright

  Label
    id: searchLabel
    text: Search:
    anchors.verticalCenter: usage.verticalCenter
    anchors.right: searchEdit.left
    margin-right: 4
    text-auto-resize: true
    color: $textBright

  TextEdit
    id: searchEdit
    anchors.verticalCenter: usage.verticalCenter
    anchors.right: parent.right
    width: 180
    height: 20

  Panel
    id: grid
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 24
    width: 718
    height: 382

    layout:
      type: grid
      cell-size: 46 46
      cell-spacing: 2
      num-columns: 15
      flow: true

  Panel
    id: filters
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    width: 718
    height: 22
    layout:
      type: horizontalBox
      spacing: 4

  Label
    id: hint
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    text-align: center
    text-auto-resize: true
    color: $textDisabled
    text: Click a tile to choose an amount, ctrl-click to take it all. Right-click a bag and choose Stash Stackables to put them in.

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 64
    height: 20

