SpellGroupIcon < UIWidget
  size: 20 20
  image-source: /images/game/spells/spellgroup-icons-20x20
  focusable: false
  opacity: 0.5
  $on:
    opacity: 1

SpellIcon < UIWidget
  size: 20 20
  image-size: 20 20
  focusable: false
  $!first:
    margin-left: 3

SpellRuneIcon < UIItem
  size: 20 20
  virtual: true
  focusable: false
  $!first:
    margin-left: 3

SpellTextIcon < UILabel
  size: 20 20
  focusable: false
  background-color: #2a2a2aff
  border-width: 1
  border-color: #5a5a5aff
  color: #e0e0e0
  font: small-9px
  text-align: center
  $!first:
    margin-left: 3

SpellTimerLabel < UILabel
  font: cooldown-timer
  color: #ffffff
  text-align: center
  focusable: false
  phantom: true

SpellProgressRect < UIProgressRect
  background: #000000AA
  percent: 100
  focusable: false
  phantom: true

Panel
  id: cooldownWindow
  height: 24
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  focusable: false
  phantom: true

  SpellGroupIcon
    id: groupIconAttack
    image-clip: 0 0 20 20
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    !tooltip: tr('Attack')

  SpellProgressRect
    id: progressRectAttack
    anchors.fill: groupIconAttack

  SpellGroupIcon
    id: groupIconHealing
    image-clip: 20 0 20 20
    anchors.top: parent.top
    anchors.left: groupIconAttack.right
    margin-top: 2
    margin-left: 3
    !tooltip: tr('Healing')

  SpellProgressRect
    id: progressRectHealing
    anchors.fill: groupIconHealing

  VerticalSeparator
    id: separator
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: groupIconHealing.right
    margin-left: 5
    margin-top: 2
    margin-bottom: 2

  // As wide as its tiles, so the weather badges can follow right behind them.
  Panel
    id: cooldownPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: separator.right
    margin-left: 5
    margin-top: 2
    margin-bottom: 2
    phantom: true
    layout:
      type: horizontalBox
      fit-children: true

  // Shown only while there are both spell tiles and weather badges
  // (refreshWeatherSeparator); hidden, it takes no room.
  VerticalSeparator
    id: weatherSeparator
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: cooldownPanel.right
    margin-top: 2
    margin-bottom: 2
    visible: false

  // game_globalboosts puts one badge per running weather event in here, anchored
  // one after another, and sets the width.
  Panel
    id: weatherPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: weatherSeparator.right
    width: 0
    margin-top: 2
    margin-bottom: 2
    phantom: true
