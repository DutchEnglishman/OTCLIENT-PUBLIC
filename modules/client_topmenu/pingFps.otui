PingFpsIcon < UIWidget
  id: icon
  size: 17 17
  anchors.left: parent.left
  anchors.verticalCenter: parent.verticalCenter
  phantom: true
  focusable: false

PingFpsText < UILabel
  id: text
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.verticalCenter: parent.verticalCenter
  margin-left: 21
  text-align: left
  font: verdana-11px-rounded
  color: #ffffff
  phantom: true
  focusable: false

PingFpsRow < UIWidget
  height: 18
  phantom: true
  focusable: false

// The height must cover every row, visible or not: a child whose rect falls
// outside its parent's is dropped by UIWidget::drawChildren, since overflow
// defaults to Hidden. fit-children shrinks this to the visible rows, so the
// value here is only the floor that keeps a row drawable before it runs.
Panel
  id: pingFpsPanel
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 4
  margin-left: 6
  width: 160
  height: 40
  layout:
    type: verticalBox
    fit-children: true

  PingFpsRow
    id: fpsRow

    PingFpsText

  PingFpsRow
    id: pingRow

    PingFpsIcon
    PingFpsText
