// Same slate texture as the battlelist, but window_headless rather than
// miniwindow_body: the body texture is drawn to butt against a header, so it
// carries no top edge and the frame came out open on one side. This one is
// bordered on all four (data/styles/10-windows.otui uses it the same way).
//
// Deliberately NO layout on the container: an earlier version used
// verticalBox with fit-children, which resizes the PARENT to fit its
// children -- combined with setting the window size in code that fed back
// into the layout and spun forever, hanging the client (Windows logged
// AppHangB1). Lines are positioned and the window sized explicitly instead.
ItemTooltipWindow < UIWidget
  id: itemTooltipWindow
  image-source: /images/ui/window_headless
  image-border: 5
  visible: false
  phantom: true
  focusable: false

// One coloured, centred line. Positioned manually by itemtooltip.lua.
//
// Tahoma Bold, loaded from data/fonts/ttf/tahomabd.ttf. The name carries no
// extension or path on purpose: TTFLoader appends ".ttf" and looks in
// data/fonts/ttf (ttfloader.cpp:119-127), the same way client_bottommenu asks
// for "verdana-bold".
//
// Every row, the name and the weight derive from this style -- and so do the
// eight outline copies behind each of them -- so the whole tooltip follows.
// The face is rasterised once and cached under "tahomabd_10", so the nine
// widgets a single line costs do not each pay for it (uiwidgettext.cpp:561).
//
// No ttf-stroke here, deliberately: runtime stroking is what hung the client
// before, which is why the outline is drawn with offset copies instead. See
// the note above ensureWidget in itemtooltip.lua.
ItemTooltipLine < UILabel
  ttf-font: tahomabd
  ttf-font-size: 10
  text-align: center
  text-auto-resize: true
  phantom: true
  focusable: false

// The weight, top-left of the header. Its own style purely so it can be set a
// size below the body text -- it is a footnote, not a stat. ttf-font is
// repeated rather than leaned on through inheritance: parseTextStyle reads the
// pair off one node (uiwidgettext.cpp:230-234), so a size with no face beside
// it would be a silent no-op.
ItemTooltipWeight < ItemTooltipLine
  ttf-font: tahomabd
  ttf-font-size: 8

// Hairline between colour groups. Width is set in code to the content width.
ItemTooltipSeparator < UIWidget
  height: 1
  background-color: #7a7a7a80
  phantom: true
  focusable: false

// The hovered item's sprite, top-right. Virtual AND phantom: virtual keeps it
// out of drag/drop, phantom keeps it from taking hover -- otherwise hovering
// the tooltip's own sprite would fire another tooltip request.
ItemTooltipSprite < UIItem
  size: 32 32
  virtual: true
  phantom: true
  focusable: false

// One empty socket. Size is the source image's own 12x10 -- scaling a 12px
// icon to a rounder number is what makes it look smeared next to crisp text.
ItemTooltipSocket < UIWidget
  size: 12 10
  image-source: /images/game/tooltip/socket_empty
  phantom: true
  focusable: false

// Filled sockets. Same box as the empty one -- only the art differs, so a
// filled socket cannot shift the row it sits in.
ItemTooltipSocketMinorPhysical < ItemTooltipSocket
  image-source: /images/game/tooltip/socket_physical_minor

ItemTooltipSocketMajorPhysical < ItemTooltipSocket
  image-source: /images/game/tooltip/socket_physical_major


ItemTooltipSocketMinorLifeSteal < ItemTooltipSocket
  image-source: /images/game/tooltip/socket_lifesteal_minor

ItemTooltipSocketMajorLifeSteal < ItemTooltipSocket
  image-source: /images/game/tooltip/socket_lifesteal_major
