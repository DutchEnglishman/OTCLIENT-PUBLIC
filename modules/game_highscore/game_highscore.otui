HighscoreCell < Label
  phantom: true
  text-align: left
  font: verdana-11px-antialised
  color: $textBright

HighscoreHeaderCell < HighscoreCell
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  color: $textDisabled

// Column widths match the header row in highscoresWindow.
HighscoreRow < UIWidget
  height: 34
  phantom: false
  background-color: alpha

  $hover:
    background-color: #ffffff12

  HighscoreCell
    id: rank
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text-align: right
    width: 36

  UICreature
    id: outfit
    anchors.left: rank.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    size: 32 32
    phantom: true
    fixed-creature-size: true

  HighscoreCell
    id: name
    anchors.left: outfit.right
    anchors.top: parent.top
    anchors.right: level.left
    margin-left: 8
    margin-top: 3
    height: 14

  HighscoreCell
    id: vocation
    anchors.left: name.left
    anchors.right: name.right
    anchors.bottom: parent.bottom
    margin-bottom: 3
    height: 14
    color: $textDisabled

  HighscoreCell
    id: points
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-align: right
    margin-right: 6
    width: 120

  HighscoreCell
    id: level
    anchors.right: points.left
    anchors.verticalCenter: parent.verticalCenter
    text-align: center
    width: 70

MainWindow
  id: highscoresWindow
  !text: tr('Highscores')
  size: 520 600
  @onEscape: modules.game_highscore.hide()

  Label
    id: listLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    !text: tr('Skill:')
    text-auto-resize: true
    color: $textDisabled

  ComboBox
    id: listBox
    anchors.verticalCenter: listLabel.verticalCenter
    anchors.left: listLabel.right
    margin-left: 6
    width: 130

  Label
    id: vocationLabel
    anchors.verticalCenter: listLabel.verticalCenter
    anchors.left: listBox.right
    margin-left: 14
    !text: tr('Vocation:')
    text-auto-resize: true
    color: $textDisabled

  ComboBox
    id: vocationBox
    anchors.verticalCenter: listLabel.verticalCenter
    anchors.left: vocationLabel.right
    margin-left: 6
    width: 120

  Button
    id: ownRankButton
    anchors.verticalCenter: listLabel.verticalCenter
    anchors.right: parent.right
    !text: tr('Show Own Rank')
    width: 100
    @onClick: modules.game_highscore.showOwnRank()

  Label
    id: title
    anchors.top: listBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    text-align: center
    color: $textBright

  UIWidget
    id: header
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-right: 16
    height: 18
    background-color: #ffffff10

    HighscoreHeaderCell
      id: rank
      anchors.left: parent.left
      text-align: right
      width: 36
      !text: tr('Rank')

    HighscoreHeaderCell
      id: name
      anchors.left: rank.right
      margin-left: 46
      anchors.right: level.left
      !text: tr('Name')

    HighscoreHeaderCell
      id: points
      anchors.right: parent.right
      text-align: right
      margin-right: 6
      width: 120
      !text: tr('Points')

    HighscoreHeaderCell
      id: level
      anchors.right: points.left
      text-align: center
      width: 70
      !text: tr('Level')

  ScrollablePanel
    id: rows
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: page.top
    margin-top: 2
    margin-bottom: 8
    layout: verticalBox
    image-source: /images/ui/miniwindow
    image-border: 4
    padding: 3
    padding-right: 16
    vertical-scrollbar: rowsScroll

  VerticalScrollBar
    id: rowsScroll
    anchors.top: rows.top
    anchors.bottom: rows.bottom
    anchors.right: rows.right
    margin: 3
    step: 34
    pixels-scroll: true

  Label
    id: empty
    anchors.centerIn: rows
    !text: tr('No records yet.')
    color: $textDisabled
    visible: false

  PreviousButton
    id: prev
    anchors.right: parent.horizontalCenter
    anchors.bottom: separator.top
    margin-right: 66
    margin-bottom: 8
    @onClick: modules.game_highscore.prevPage()
    $disabled:
      opacity: 0.5

  Label
    id: page
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: prev.verticalCenter
    width: 120
    text-align: center
    color: $textBright

  NextButton
    id: next
    anchors.left: page.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 6
    @onClick: modules.game_highscore.nextPage()
    $disabled:
      opacity: 0.5

  Label
    id: total
    anchors.left: parent.left
    anchors.verticalCenter: prev.verticalCenter
    text-auto-resize: true
    color: $textDisabled

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 60
    !text: tr('Close')
    @onClick: modules.game_highscore.hide()
