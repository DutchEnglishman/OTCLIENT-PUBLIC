WhiteDoveBox < CombatBox
  image-source: /images/game/combatmodes/whitedovemode
WhiteHandBox < CombatBox
  image-source: /images/game/combatmodes/whitehandmode
YellowHandBox < CombatBox
  image-source: /images/game/combatmodes/yellowhandmode
RedFistBox < CombatBox
  image-source: /images/game/combatmodes/redfistmode
SafeFightBox < CombatBox
  image-source: /images/game/combatmodes/safefight

StandModeBox < UICheckBox
  size: 20 20
  image-source: /images/inventory/buttons_general
  image-clip: 0 0 20 20
  $checked:
    image-clip: 20 0 20 20

ChaseModeBox < UICheckBox
  size: 20 20
  image-source: /images/inventory/buttons_general
  image-clip: 0 20 20 20
  $checked:
    image-clip: 20 20 20 20

ConditionWidget < UIWidget
  size: 10 10

  $!first:
    margin-left: 2

PhantomMiniWindow
  id: maininventorypanel
  draggable: true
  phantom: false
  moveOnlyToMain: false
  // 167, not 162: the extra 5 is the breathing room added below the status
  // icon row, which is bottom-anchored and was sitting flush on the frame.
  height: 167
  &panelHeight: 167
  on: true

  $!on:
    &panelHeight: 62
    height: 62

  UIWidget
    id: onPanel
    anchors.fill: parent
    phantom: true

    Button
      id: changeSize
      image-source: /images/inventory/min_button_small
      image-clip: 0 0 12 12
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 8
      margin-top: 5
      size: 12 12
      @onClick: changeInventorySize()

      $pressed !disabled:
        image-clip: 12 0 12 12

    Button
      id: blessings
      image-source: /images/inventory/button_blessings_grey
      image-clip: 0 0 12 12
      anchors.top: changeSize.top
      anchors.left: changeSize.right
      margin-left: 3
      size: 12 12
      @onClick: modules.game_blessing.toggle()
      $pressed !disabled:
        image-clip: 12 0 12 12

    UIButton
      id: purseButton
      image-source: /images/inventory/purse
      !tooltip: tr('Open purse')
      anchors.left: backpack.left
      anchors.bottom: backpack.top   
      size: 34 12
      image-clip: 0 0 34 12
      margin-bottom: 3
      @onClick: |
        local purse = g_game.getLocalPlayer():getInventoryItem(InventorySlotPurse)
        if purse then
            g_game.use(purse)
        end

      $on:
        image-clip: 0 12 34 12
      $pressed:
        image-clip: 0 12 34 12

    TopToggleButton
      id: standPosture
      image-source: /images/inventory/buttons_general
      image-clip: 0 0 20 20
      anchors.right: parent.right
      anchors.top: changeSize.top
      margin-right: 7
      size: 20 20
      @onClick: |
        selectPosture('stand')

      $pressed !disabled:
        image-clip: 20 0 20 20

      $disabled:
        image-clip: 20 0 20 20

    TopToggleButton
      id: followPosture
      image-source: /images/inventory/buttons_general
      image-clip: 0 20 20 20
      anchors.right: standPosture.right
      anchors.top: standPosture.bottom
      margin-top: 4
      size: 20 20
      @onClick: |
        selectPosture('follow')

      $pressed !disabled:
        image-clip: 20 20 20 20

      $disabled:
        image-clip: 20 20 20 20
    UICheckBox
      id: expert
      image-source: /data/images/inventory/button-expert-up
      anchors.right: standPosture.right
      anchors.top: followPosture.bottom
      phantom: false
      margin-top: 4
      size: 20 20

      $checked:
        image-source: /data/images/inventory/button-expert-down

      $disabled:
        image-source: /data/images/inventory/button-expert-disabled


    UICheckBox
      id: pvp
      image-source: /images/game/combatmodes/onPanel
      size: 44 21
      image-clip: 0 0 44 21
      margin: 2 4
      anchors.right: standPosture.right
      anchors.top: expert.bottom
      margin-top: 4
      margin-right: 0
      phantom: false
      size: 44 21

      $checked:
        image-clip: 0 20 44 21


    WhiteHandBox
      id: whiteHandBox
      anchors.right: parent.right
      anchors.top: pvp.bottom
      margin-right: 8
      margin-top: 5

    RedFistBox
      id: redFistBox
      anchors.right: whiteHandBox.right
      anchors.top: whiteHandBox.bottom
      margin-right: -1
      margin-right: 0

    WhiteDoveBox
      id: whiteDoveBox
      anchors.right: whiteHandBox.left
      anchors.top: whiteHandBox.top
      margin-top: 0

    YellowHandBox
      id: yellowHandBox
      anchors.right: whiteDoveBox.right
      anchors.top: whiteDoveBox.bottom
      margin-right: 0

    TopToggleButton
      id: attack
      image-source: /images/inventory/buttons_general
      image-clip: 0 40 20 20
      anchors.right: standPosture.left
      anchors.top: standPosture.top
      margin-right: 4
      size: 20 20
      @onClick: |
        selectCombat('attack')

      $pressed !disabled:
        image-clip: 20 40 20 20

      $disabled:
        image-clip: 20 40 20 20

    TopToggleButton
      id: balanced
      image-source: /images/inventory/buttons_general
      image-clip: 0 80 20 20
      anchors.right: attack.right
      anchors.top: attack.bottom
      margin-top: 4
      size: 20 20
      @onClick: |
        selectCombat('balanced')

      $pressed !disabled:
        image-clip: 20 80 20 20

      $disabled:
        image-clip: 20 80 20 20

    TopToggleButton
      id: defense
      image-source: /images/inventory/buttons_general
      image-clip: 0 60 20 20
      anchors.right: attack.right
      anchors.top: balanced.bottom
      margin-top: 4
      size: 20 20
      @onClick: |
        selectCombat('defense')

      $pressed !disabled:
        image-clip: 20 60 20 20

      $disabled:
        image-clip: 20 60 20 20

    // Shortcut grid, two columns by three rows of 20x20, filling the space
    // under the pvp checkbox.
    //
    //     [options ] [hotkeys ]
    //     [loot    ] [store   ]
    //     [widgets ] [logout  ]
    //
    // That space is free on this protocol: the expert checkbox and the four
    // expert pvp-mode boxes that would sit here are hidden unless
    // GamePVPMode is on, and features.lua only enables it from client 1000
    // (this server is 860) -- see the showPVPMode gate in inventory.lua.
    //
    // Everything chains off the logout button in the bottom-right, so moving
    // that one moves the whole grid.
    //
    // MainToggleButton is the same style the mainpanel shortcut row uses: the
    // icons are 40x20 sprite pairs and it clips 0/20 for the normal and
    // pressed halves. The store keeps its own artwork, which is 26x20, hence
    // the fixed ratio so it is not squashed into the square.
    MainToggleButton
      id: logoutToggle
      !tooltip: tr('Exit')
      anchors.right: standPosture.right
      anchors.bottom: parent.bottom
      margin-bottom: 4
      size: 20 20
      image-source: /images/options/button_logout
      @onClick: modules.game_interface.tryLogout()

    MainToggleButton
      id: widgetsToggle
      !tooltip: tr('Options')
      anchors.right: logoutToggle.left
      anchors.bottom: logoutToggle.bottom
      margin-right: 4
      size: 20 20
      image-source: /images/options/button_control
      @onClick: modules.game_widgets.toggle()

    UIButton
      id: store
      !tooltip: tr('Open the store')
      anchors.right: logoutToggle.right
      anchors.bottom: logoutToggle.top
      margin-bottom: 2
      size: 20 20
      image-source: /images/game/prey/prey_smallstore
      image-clip: 0 0 26 20
      image-fixed-ratio: true
      @onClick: modules.game_mainpanel.toggleStore()

      $pressed:
        image-source: /images/game/prey/prey_smallstore_clicked
        image-clip: -1 -1 27 21

    MainToggleButton
      id: lootToggle
      !tooltip: tr('Loot')
      anchors.right: store.left
      anchors.bottom: store.bottom
      margin-right: 4
      size: 20 20
      image-source: /images/topbuttons/autoloot
      @onClick: modules.game_autoloot.toggle()

    MainToggleButton
      id: hotkeysToggle
      !tooltip: tr('Hotkeys')
      anchors.right: logoutToggle.right
      anchors.bottom: store.top
      margin-bottom: 2
      size: 20 20
      image-source: /images/options/hotkeys
      @onClick: modules.game_hotkeys.toggle()

    MainToggleButton
      id: optionsToggle
      !tooltip: tr('Options')
      anchors.right: hotkeysToggle.left
      anchors.bottom: hotkeysToggle.bottom
      margin-right: 4
      size: 20 20
      image-source: /images/options/button_options
      @onClick: modules.client_options.toggle()

    Panel
      id: icons
      // Height was previously borrowed from the Stop button's top anchor. Held
      // explicitly now so the button beside it can be sized independently.
      size: 108 13
      padding: 2

      image-source: /images/ui/containerslot
      image-border: 3
      // Tracks the slot grid rather than the corner button, so it stays the
      // same width as the slots above it now that they're centred.
      anchors.left: amulet.left
      anchors.right: backpack.right
      anchors.bottom: parent.bottom
      margin-bottom: 5
      layout:
        type: horizontalBox

    MainInventoryItem
      id: amulet
      anchors.top: changeSize.bottom
      anchors.left: parent.left
      margin-top: 3
      // Root of the whole slot grid -- every other slot chains off this one,
      // so this margin positions all of them. The grid is 3 columns of 34
      // plus two 3px gaps = 108 wide, and the combat buttons begin 51 in from
      // the right edge (standPosture 27 in, attack 24 left of that), so on the
      // 184-wide panel they start at 133 and (133 - 108) / 2 = 12 centres the
      // grid in the space they leave (12 left, 13 right -- the odd pixel has to
      // land on one side).
      // Previously pinned to changeSize.left, which has to stay in the corner.
      //
      // 12, not 28: GameSidePanel narrowed from 215 to 184, so this follows it.
      margin-left: 12
      &slotPosition: {x = 65535, y = 2, z = 0}

    MainInventoryItem
      id: helmet
      anchors.top: changeSize.top
      anchors.left: amulet.right
      margin-left: 3
      &slotPosition: {x = 65535, y = 1, z = 0}

    MainInventoryItem
      id: backpack
      anchors.top: amulet.top
      anchors.left: helmet.right
      margin-left: 3
      &slotPosition: {x = 65535, y = 3, z = 0}

    MainInventoryItem
      id: sword
      anchors.top: amulet.bottom
      anchors.left: amulet.left
      margin-top: 3
      &slotPosition: {x = 65535, y = 6, z = 0}

    MainInventoryItem
      id: ring
      anchors.top: sword.bottom
      anchors.left: amulet.left
      margin-top: 3
      &slotPosition: {x = 65535, y = 9, z = 0}

    MainInventoryItem
      id: armor
      anchors.top: helmet.bottom
      anchors.left: helmet.left
      margin-top: 3
      &slotPosition: {x = 65535, y = 4, z = 0}

    MainInventoryItem
      id: legs
      anchors.top: armor.bottom
      anchors.left: helmet.left
      margin-top: 3
      &slotPosition: {x = 65535, y = 7, z = 0}

    MainInventoryItem
      id: boots
      anchors.top: legs.bottom
      anchors.left: helmet.left
      margin-top: 3
      &slotPosition: {x = 65535, y = 8, z = 0}

    MainInventoryItem
      id: shield
      anchors.top: backpack.bottom
      anchors.left: backpack.left
      margin-top: 3
      &slotPosition: {x = 65535, y = 5, z = 0}

    MainInventoryItem
      id: tools
      anchors.top: shield.bottom
      anchors.left: backpack.left
      margin-top: 3
      &slotPosition: {x = 65535, y = 10, z = 0}

    UIWidget
      id: taskPointsPanel
      image-source: /images/inventory/containerslot
      image-border: 3
      phantom: false
      !tooltip: tr('Task points')
      anchors.left: amulet.left
      anchors.right: amulet.right
      anchors.bottom: boots.bottom
      anchors.top: ring.bottom
      margin-top: 3

      // Both top-anchored. A bottom-anchored child of this panel never drew
      // anything here -- not even its own otui default -- so everything that
      // has to be visible hangs off the top edge.
      //
      // The icon is declared first because the number's right edge anchors to
      // it. The number then owns whatever is left of the 34px slot, with
      // text-align doing the centring: an auto-sized label centred on a point
      // sized itself to its text and let wide values run past the edge.
      UIWidget
        id: taskPointsIcon
        image-source: /images/icons/taskpoints
        size: 8 8
        phantom: true
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 6
        margin-right: 2

      Label
        id: taskPoints
        !text: tr('TP')
        !tooltip: tr('Task points')
        text-align: center
        font: cipsoftFont
        anchors.left: parent.left
        anchors.right: taskPointsIcon.left
        anchors.top: parent.top
        color: #c0c0c0ff
        margin-top: 5

    UIWidget
      id: capacityPanel
      image-source: /images/inventory/containerslot
      image-border: 3
      phantom: false
      anchors.left: backpack.left
      anchors.right: backpack.right
      anchors.bottom: boots.bottom
      anchors.top: tools.bottom
      margin-top: 3

      Label
        !text: tr('Cap')
        text.align: center
        font: cipsoftFont
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        color: #c0c0c0ff
        margin-top: 1

      Label
        id: capacity
        !text: '10000'
        font: cipsoftFont
        text-align: center
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        color: #c0c0c0ff

  UIWidget
    id: offPanel
    anchors.fill: parent
    phantom: true
    visible: false

    Button
      id: changeSize
      image-source: /images/inventory/max_button_small
      image-clip: 0 0 12 12
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 8
      margin-top: 5
      size: 12 12
      @onClick: changeInventorySize()

      $pressed !disabled:
        image-clip: 12 0 12 12

    UIWidget
      id: capacityAndTaskPoints
      image-source: /images/inventory/containerslot
      image-border: 3
      phantom: false
      anchors.left: changeSize.right
      anchors.top: changeSize.top
      margin-left: 4
      size: 30 44

      Label
        !text: tr('Cap')
        text.align: center
        font: cipsoftFont
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        color: #c0c0c0ff
        margin-top: 1
        height: 10

      Label
        id: capacity
        !text: '10000'
        font: cipsoftFont
        text-align: center
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        margin-top: 8
        color: #c0c0c0ff

      // Same number-then-icon pairing as taskPointsPanel above, in a box 4px
      // narrower, so the number has correspondingly less room here.
      UIWidget
        id: taskPointsIcon
        image-source: /images/icons/taskpoints
        size: 8 8
        // Not phantom here, unlike the expanded panel: this box also holds
        // Capacity, so the tooltip cannot live on the parent without
        // mislabelling that half.
        phantom: false
        !tooltip: tr('Task points')
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-bottom: 8
        margin-right: 1

      Label
        id: taskPoints
        !text: tr('TP')
        !tooltip: tr('Task points')
        phantom: false
        text-align: center
        font: cipsoftFont
        anchors.left: parent.left
        anchors.right: taskPointsIcon.left
        anchors.bottom: parent.bottom
        color: #c0c0c0ff
        margin-bottom: 8
        height: 10

    TopToggleButton
      id: attack
      image-source: /images/inventory/buttons_general
      image-clip: 0 40 20 20
      anchors.left: capacityAndTaskPoints.right
      anchors.top: changeSize.top
      margin-left: 3
      size: 20 20
      @onClick: |
        selectCombat('attack')

      $pressed !disabled:
        image-clip: 20 40 20 20

      $disabled:
        image-clip: 20 40 20 20

    TopToggleButton
      id: defense
      image-source: /images/inventory/buttons_general
      image-clip: 0 60 20 20
      anchors.left: attack.right
      anchors.top: changeSize.top
      margin-left: 1
      size: 20 20
      @onClick: |
        selectCombat('defense')

      $pressed !disabled:
        image-clip: 20 60 20 20

      $disabled:
        image-clip: 20 60 20 20

    TopToggleButton
      id: balanced
      image-source: /images/inventory/buttons_general
      image-clip: 0 80 20 20
      anchors.left: defense.right
      anchors.top: changeSize.top
      margin-left: 1
      size: 20 20
      @onClick: |
        selectCombat('balanced')

      $pressed !disabled:
        image-clip: 20 80 20 20

      $disabled:
        image-clip: 20 80 20 20

    TopToggleButton
      id: standPosture
      image-source: /images/inventory/buttons_general
      image-clip: 0 0 20 20
      anchors.left: attack.left
      anchors.top: attack.bottom
      margin-top: 4
      size: 20 20
      @onClick: |
        selectPosture('stand')

      $pressed !disabled:
        image-clip: 20 0 20 20

      $disabled:
        image-clip: 20 0 20 20

    TopToggleButton
      id: followPosture
      image-source: /images/inventory/buttons_general
      image-clip: 0 20 20 20
      anchors.left: standPosture.right
      anchors.top: standPosture.top
      margin-left: 1
      size: 20 20
      @onClick: |
        selectPosture('follow')

      $pressed !disabled:
        image-clip: 20 20 20 20

      $disabled:
        image-clip: 20 20 20 20
    SafeFightBox
      id: pvp
      anchors.left: followPosture.right
      anchors.top: standPosture.top
      margin-left: 1
      margin-top: 0
      phantom: false

    UIWidget
      id: expert
      image-source: /data/images/inventory/button-expert-up
      anchors.left: changeSize.left
      anchors.bottom: capacityAndTaskPoints.bottom
      phantom: false
      size: 12 12
      @onClick: |
        expertMode()

      $checked:
        image-source: /data/images/inventory/button-expert-down

      $disabled:
        image-source: /data/images/inventory/button-expert-disabled

    Button
      id: blessings
      image-source: /images/inventory/button_blessings_grey
      image-clip: 0 0 12 12
      anchors.top: expert.bottom
      anchors.left: changeSize.left
      margin-top: 3
      size: 12 12
      @onClick: modules.game_blessing.toggle()
      $pressed !disabled:
        image-clip: 12 0 12 12

    Panel
      id: icons
      anchors.left: capacityAndTaskPoints.left
      anchors.right: pvp.right
      anchors.bottom: parent.bottom
      anchors.top: blessings.top
      phantom: false
      image-source: /images/ui/containerslot
      image-border: 3
      layout:
        type: horizontalBox

    UIButton
      id: store
      !tooltip: tr('Open the store')
      anchors.right: parent.right
      margin-right: 7
      anchors.bottom: icons.bottom
      size: 20 20
      image-source: /images/game/prey/prey_smallstore
      image-clip: 0 0 26 20
      image-fixed-ratio: true
      @onClick: modules.game_mainpanel.toggleStore()

      $pressed:
        image-source: /images/game/prey/prey_smallstore_clicked
        image-clip: -1 -1 27 21
